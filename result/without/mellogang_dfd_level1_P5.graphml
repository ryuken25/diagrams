          <y:Arrows source="none" target="standard"/>
          <y:EdgeLabel fontSize="11" backgroundColor="#FFFFFF">data_tugas_editing</y:EdgeLabel>
          <y:BendStyle smoothed="true"/>
        </y:PolyLineEdge>
      </data>
    </edge>
  </graph>
</graphml>
