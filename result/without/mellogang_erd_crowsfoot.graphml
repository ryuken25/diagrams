          <y:Fill color="#FFFFFF" transparent="false"/>
          <y:BorderStyle color="#1F3A5F" type="line" width="1.0"/>
          <y:NodeLabel fontSize="12" fontStyle="plain" alignment="center" modelName="internal" modelPosition="c" autoSizePolicy="content">User
────────────────
PK id_user
   nama_lengkap
   email
   no_telepon
   password
   role
   created_at
   updated_at</y:NodeLabel>
